
clear; clc; close all;
%% Common settings
gamma_show = [1, 0.1, 0.01, 0.001];
gamma_scan = linspace(0.001, 1, 100);
u = linspace(1e-6, 1-1e-6, 7500);
colors = [0.00 0.45 0.74; 0.85 0.32 0.10; ...
          0.47 0.67 0.19; 0.55 0.25 0.64];
styles = {'--','-.',':','-'};
red = [0.86 0.10 0.12];

%% Left and Right Bound
a = -1;
b = 1;

gamma_plot = [1, 0.1, 0.01, 0.001];
gammas = logspace(0, -3, 60);

% Fine spatial grid
x = linspace(-3, 5, 200001);
dx = x(2) - x(1);

% Potential and unnormalized density
f = @(x) x.^2 + x.^4/8 - x;
w = exp(-f(x));

% Distance to K = [a,b]
distK = max(a-x, 0) + max(x-b, 0);

%% Constrained target density
p = w .* (x >= a & x <= b);
p = p / trapz(x, p);

% Target CDF
F = cumtrapz(x, p);
F = F / F(end);

%% Quantile grid for computing W2
t = linspace(1e-7, 1-1e-7, 100000);

% Unique CDF values for inverse interpolation
[F_unique, idx] = unique(F, 'stable');
x_unique = x(idx);

Finv = interp1(F_unique, x_unique, t, ...
               'linear', 'extrap');

%% Compute W2 for different gamma
W2 = zeros(size(gammas));

for k = 1:length(gammas)
    gamma = gammas(k);

    % Penalized density
    q = w .* exp(-distK.^2/(2*gamma));
    q = q / trapz(x, q);

    % Penalized CDF
    G = cumtrapz(x, q);
    G = G / G(end);

    [G_unique, idx] = unique(G, 'stable');
    xG = x(idx);

    Ginv = interp1(G_unique, xG, t, ...
                   'linear', 'extrap');

    % One-dimensional W2
    W2(k) = sqrt(trapz(t, (Finv-Ginv).^2));
end

%% 1 x 2 Figure
figure('Color','w','Units','inches', ...
    'Position',[1 1 12.5 4], 'PaperPositionMode','auto');

%% Left subplot: densities
subplot(1,2,1);
hold on;

plot(x, p, 'k-', 'LineWidth', 1.2, ...
    'DisplayName', '\pi(x)');


for k = 1:length(gamma_plot)
    gamma = gamma_plot(k);

    q = w .* exp(-distK.^2/(2*gamma));
    q = q / trapz(x, q);

    plot(x, q, 'LineWidth', 1.1, ...
        'Color', colors(k,:), ...
        'LineStyle',styles{k},'LineWidth',1.10, ...
        'DisplayName', sprintf('\\pi^\\gamma(x),\\;  = %.3g',gamma));
end

xline(a, 'k:', 'HandleVisibility','off');
xline(b, 'k:', 'HandleVisibility','off');

xlabel('$x$', 'Interpreter','latex');
ylabel('Density', 'Interpreter','latex');
legend('Location','northeast');
xlim([-1.5 3.5]);
grid on;
box on;
set(gca,'FontSize',12);

%% Right subplot: Wasserstein distance
subplot(1,2,2);

semilogx(gammas, W2, 'b-', 'LineWidth', 1);
hold on;

% Optional reference: O(sqrt(gamma))
C = W2(end)/sqrt(gammas(end));
semilogx(gammas, C*sqrt(gammas), 'r--', ...
         'LineWidth', 1);

xlabel('$\gamma$', 'Interpreter','latex');
ylabel('$W_2(\pi,\pi^\gamma)$', ...
       'Interpreter','latex');

legend('$W_2(\pi,\pi^\gamma)$', ...
       '$C\sqrt{\gamma}$', ...
       'Interpreter','latex', ...
       'Location','northeast');

set(gca,'XDir','reverse');
grid on;
box on;
set(gca,'FontSize',12);


%% Display numerical results
fprintf('     gamma          W2\n');
fprintf('--------------------------\n');

for k = 1:length(gammas)
    fprintf('%12.6f    %12.8f\n',gammas(k),W2(k));
end
